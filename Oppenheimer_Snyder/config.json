{
    "physical": {
        "parameters": {
            "adiabatic_constant": "5/3",
            "temporal_range": [0.0, 1.0],
            "spatial_range": [0.0, 1.0],
            "N_t": "2**8",
            "N_x": "2**7",
            "N_0": "2**6",
            "sampling_method": "sobol"
        },
        "initial_conditions": {
            "density": [0.19098593, 0.0],
            "velocity": [0.0, 0.0],
            "pressure": [0.0, 0.0]
        }
    },
    "neural": {
        "general_parameters": {
            "number_hidden": 6,
            "number_neurons": 50
        },
        "activation_functions": {
            "hidden_layers": "nn.Tanh()",
            "output": ["nn.Softplus()", "nn.Tanh()", "nn.Sigmoid()"]
        },
        "loss_function_parameters": {
            "w_R": 1.0,
            "w_IC": [1e4, 1e4, 1e4],
            "w_C": 4e4,
            "w_Phi": 4e4,
            "w_PDE_m": 2.0,
            "w_PDE_Phi": 2.0,
            "w_symmetry": 200.0,
            "w_subluminal": 0.1,
            "w_supervision": 500.0,
            "α_set": [1.0, 1.0, 1.0],
            "β_set": [1.25, 1.25, 1.25],
            "ε_t": 1.0,
            "curriculum_phase1_end": 5000,
            "curriculum_phase2_end": 15000,
            "ic_decay_tau": 5000.0
        }
    },
    "training_process": {
        "device": "cuda",
        "DTYPE": "torch.float32",
        "import": {
            "analytical_solution_path": "../Ground_Data/Oppenheimer_Snyder/collapse_data.h5"
        },
        "export": {
            "path_images": "Images/",
            "path_data": "Models_Data/",
            "path_models": "Models_Data/Model_Saved/",
            "save_each_images": 1000,
            "save_each_data": 5000,
            "save_each_checkpoint": 2500
        },
        "parameters": {
            "learning_rate": 1e-4,
            "epochs": 50000,
            "random_seed": 123456
        }
    }
}
